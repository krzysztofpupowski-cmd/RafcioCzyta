---
import Layout from "@/layouts/Layout.astro";
import ChildProfileForm from "@/components/child/ChildProfileForm";
import { createClient } from "@/lib/supabase";
import { getMyChild } from "@/lib/services/children";

// Middleware (PROTECTED_ROUTES) guarantees both are non-null here.
const userId = Astro.locals.user?.id ?? "";
const userEmail = Astro.locals.user?.email;

const supabase = createClient(Astro.request.headers, Astro.cookies);

let childDisplayName = "";
let childLevel: string | null = null;
let fetchError: string | null = null;

if (!supabase) {
  fetchError = "Supabase nie jest skonfigurowany";
} else {
  try {
    // eslint-disable-next-line @typescript-eslint/no-unsafe-assignment
    const child = await getMyChild(supabase, userId);
    if (child) {
      // eslint-disable-next-line @typescript-eslint/no-unsafe-member-access
      childDisplayName = child.display_name as string;
      // eslint-disable-next-line @typescript-eslint/no-unsafe-member-access
      childLevel = child.current_level as string | null;
    }
  } catch (err) {
    fetchError = err instanceof Error ? err.message : "Nie udało się pobrać profilu dziecka";
  }
}

const serverError = Astro.url.searchParams.get("error") ?? fetchError;
---

<Layout title="Profil dziecka">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-md rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <div class="mb-6 flex items-center justify-between">
        <div>
          <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
            Profil dziecka
          </h1>
          <p class="mt-1 text-sm text-blue-100/60">
            Zalogowany jako <span class="font-medium text-white/80">{userEmail}</span>
          </p>
        </div>
        <form method="POST" action="/api/auth/signout">
          <button
            type="submit"
            class="rounded-lg border border-white/20 bg-white/10 px-3 py-1.5 text-xs transition-colors hover:bg-white/20"
          >
            Wyloguj
          </button>
        </form>
      </div>

      <ChildProfileForm
        initialDisplayName={childDisplayName}
        initialLevel={childLevel}
        serverError={serverError}
        client:load
      />
    </div>
  </div>
</Layout>
