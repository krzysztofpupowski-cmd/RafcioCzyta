---
import Layout from "@/layouts/Layout.astro";
import ChildProfileForm from "@/components/child/ChildProfileForm";
import FlashcardDashboardCard from "@/components/flashcards/FlashcardDashboardCard";
import { createClient } from "@/lib/supabase";
import { getMyChild } from "@/lib/services/children";
import { listDraftBatches, listAcceptedFlashcards } from "@/lib/services/flashcards";
import type { DraftBatchDTO, AcceptedFlashcardDTO } from "@/lib/dto/flashcards";

// Middleware (PROTECTED_ROUTES) guarantees this is non-null, but narrow defensively.
if (!Astro.locals.user) {
  return Astro.redirect("/auth/signin");
}
const { id: userId, email: userEmail } = Astro.locals.user;

const supabase = createClient(Astro.request.headers, Astro.cookies);

let childDisplayName = "";
let childLevel: string | null = null;
let childExists = false;
let childId = "";
let fetchError: string | null = null;
let initialDraftBatches: DraftBatchDTO[] = [];
let initialAcceptedCards: AcceptedFlashcardDTO[] = [];
let flashcardFetchError: string | null = null;

if (!supabase) {
  fetchError = "Supabase nie jest skonfigurowany";
} else {
  try {
    // eslint-disable-next-line @typescript-eslint/no-unsafe-assignment
    const child = await getMyChild(supabase, userId);
    if (child) {
      // eslint-disable-next-line @typescript-eslint/no-unsafe-assignment, @typescript-eslint/no-unsafe-member-access
      childDisplayName = child.display_name;
      // eslint-disable-next-line @typescript-eslint/no-unsafe-assignment, @typescript-eslint/no-unsafe-member-access
      childLevel = child.current_level;
      // eslint-disable-next-line @typescript-eslint/no-unsafe-assignment, @typescript-eslint/no-unsafe-member-access
      childId = child.id;
      childExists = true;
    }
  } catch (err) {
    fetchError = err instanceof Error ? err.message : "Nie udało się pobrać profilu dziecka";
  }

  if (childExists && childId) {
    try {
      initialDraftBatches = await listDraftBatches(supabase, childId);
      initialAcceptedCards = await listAcceptedFlashcards(supabase, childId);
    } catch (err) {
      // eslint-disable-next-line no-console -- server-side diagnostic only; user sees generic copy below
      console.error("Failed to fetch flashcard lists", err);
      flashcardFetchError = "Nie udało się pobrać listy fiszek. Spróbuj odświeżyć stronę.";
    }
  }
}

const serverError = Astro.url.searchParams.get("error") ?? fetchError;
---

<Layout title="Profil dziecka">
  <div class="bg-cosmic flex min-h-screen items-start justify-center p-4 sm:items-center">
    <div class="flex w-full max-w-md flex-col gap-6">
      <div class="w-full rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
        <div class="mb-6 flex items-center justify-between">
          <div>
            <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
              Profil dziecka
            </h1>
            <p class="mt-1 text-sm text-blue-100/60">
              Zalogowany jako <span class="font-medium text-white/80">{userEmail}</span>
            </p>
          </div>
          <form method="POST" action="/api/auth/signout">
            <button
              type="submit"
              class="rounded-lg border border-white/20 bg-white/10 px-3 py-1.5 text-xs transition-colors hover:bg-white/20"
            >
              Wyloguj
            </button>
          </form>
        </div>

        <ChildProfileForm
          initialDisplayName={childDisplayName}
          initialLevel={childLevel}
          serverError={serverError}
          client:load
        />
      </div>

      <FlashcardDashboardCard
        childExists={childExists}
        childLevel={childLevel}
        initialDraftBatches={initialDraftBatches}
        initialAcceptedCards={initialAcceptedCards}
        initialError={flashcardFetchError}
        client:load
      />
    </div>
  </div>
</Layout>
