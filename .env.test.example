# Hosted Supabase test project only — never use production credentials.
# Copy to .env.test and fill after applying tests/fixtures/seed.sql (Phase 3).
# Playwright E2E reuses TEST_PARENT_A_* for auth.setup.ts (storageState).

SUPABASE_URL=https://your-test-project.supabase.co
SUPABASE_KEY=your-anon-publishable-key
OPENAI_API_KEY=sk-test-dummy

TEST_PARENT_A_EMAIL=parent-a@test.example
TEST_PARENT_A_PASSWORD=replace-with-test-password
TEST_PARENT_B_EMAIL=parent-b@test.example
TEST_PARENT_B_PASSWORD=replace-with-test-password

# Populate from seed.sql (fixed UUIDs in tests/fixtures/seed.sql)
# v4-shaped UUIDs (required by zod z.uuid() in API handlers) — must match seed.sql
TEST_PARENT_A_GENERATION_ID=bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbb1
TEST_PARENT_A_CHILD_ID=aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa1
TEST_PARENT_B_CHILD_ID=11111111-1111-4111-8111-111111111101
TEST_PARENT_B_GENERATION_ID=22222222-2222-4222-8222-222222222201
TEST_PARENT_B_SESSION_ID=33333333-3333-4333-8333-333333333301
